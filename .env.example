# Local-only development defaults. Never put real keys or production values here.
POSTGRES_USER=evidencerag
POSTGRES_PASSWORD=change-me
POSTGRES_DB=evidencerag
DATABASE_URL=jdbc:postgresql://localhost:5432/evidencerag
DB_HOST_PORT=5432
API_HOST_PORT=8080
WEB_HOST_PORT=5173
VITE_API_BASE_URL=http://localhost:8080

# Local Ollama. Set both model families and dimensions consistently with pgvector.
CHAT_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
APP_EMBEDDING_MODEL=nomic-embed-text
APP_EMBEDDING_DIMENSIONS=768
APP_DOCUMENT_VISIBILITY=local

# Optional local API access control; never expose this shared token in a public frontend.
APP_API_TOKEN=
APP_CORS_ORIGIN=http://localhost:5173
APP_REQUESTS_PER_MINUTE=60
APP_MAX_CONCURRENT_AI_REQUESTS=2
APP_MAX_UPLOAD_BYTES=10485760
APP_MIN_SIMILARITY=0.72
APP_PUBLIC_DEMO_CORPUS_ONLY=false

# Gemini profile settings; keep keys in a local secret manager or Render dashboard.
# CHAT_PROVIDER=google-genai
# EMBEDDING_PROVIDER=google-genai
# GEMINI_API_KEY=
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
