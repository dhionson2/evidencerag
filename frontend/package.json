{
  "name": "evidencerag-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --mode live",
    "dev:rag": "vite --host 0.0.0.0 --mode rag",
    "build": "tsc -b && vite build --mode portfolio",
    "build:pages": "tsc -b && vite build --mode pages",
    "build:live": "tsc -b && vite build --mode live",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^10.15.0",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^7.1.7",
    "vitest": "^5.1.1"
  }
}
